{
  "name": "kom-epk-builder",
  "description": "Canva app that builds the Killer of Men EPK pages from canva/ops/epk-canva.json.",
  "version": "0.1.0",
  "engines": {
    "node": "^22 || ^24"
  },
  "scripts": {
    "start": "canva apps start",
    "start:preview": "canva apps start --preview",
    "build": "canva apps build",
    "lint:types": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier '{src,scripts}/**/*.{css,ts,tsx,json,js,mjs}' --write",
    "postinstall": "tsx ./scripts/copy_env.ts"
  },
  "private": true,
  "dependencies": {
    "@canva/app-hooks": "^0.0.0-beta.4",
    "@canva/app-i18n-kit": "^1.3.0",
    "@canva/app-ui-kit": "^5.14.3",
    "@canva/asset": "^2.3.0",
    "@canva/design": "^2.13.0",
    "@canva/error": "^2.2.1",
    "@canva/intents": "^2.7.0",
    "@canva/platform": "^2.2.2",
    "@canva/user": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intl": "^7.1.11"
  },
  "devDependencies": {
    "@canva/app-eslint-plugin": "^1.0.0",
    "@canva/app-scripts": "^1.1.1",
    "@canva/cli": "2.12.0",
    "@rspack/core": "2.0.8",
    "@swc/core": "1.15.1",
    "@swc/plugin-formatjs": "8.0.0",
    "@types/node": "22.19.17",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@types/webpack-env": "1.18.8",
    "eslint": "9.34.0",
    "postcss": "8.5.26",
    "prettier": "3.6.2",
    "tsx": "4.22.4",
    "typescript": "5.9.2",
    "webpack": "5.105.2",
    "webpack-dev-server": "5.2.6"
  },
  "overrides": {
    "@canva/app-scripts": {
      "@rspack/core": "$@rspack/core"
    }
  }
}
